package iris:ascot;

interface common {

    record position {
        line: u32,
        character: u32,
    }

    record range {
        start: position,
        end: position,
    }

    record location {
        uri: string,
        range: range,
    }

    record diagnostic-related-information {
        location: location,
        message: string,
    }

    record name-info {
        before: position,
        content: string,
        after: position,
    }

    // How a parameter is passed by reference; `none` is by value.
    enum ref-mode {
        by-ref,
        // No value is expected to come in.
        output,
    }

    record normal-arg {
        mode: option<ref-mode>,
        name: string,
        t: option<string>,
        default: option<string>,
        declared-at: option<range>,
    }

    record variadic-arg {
        mode: option<ref-mode>,
        name: string,
        t: option<string>,
        declared-at: option<range>,
    }

    record method-info {
        normal: list<normal-arg>,
        variadic: option<variadic-arg>,
        t: option<string>,
        procedure-block: option<list<string>>,
        body: range,
    }

    record parameter-info {
        t: option<string>,
        v: option<string>
    }

    enum collection-kind { %list, array }

    // `t` is the element type for a `list Of`/`array Of` property.
    record property-info {
        t: option<string>,
        collection: option<collection-kind>,
        multidimensional: bool,
    }

    enum cardinality { one, many, parent, children }

    // `t` is the related class.
    record relationship-info {
        t: option<string>,
        cardinality: option<cardinality>,
    }

    variant member-kind {
        parameter(parameter-info),
        property(property-info),
        relationship(relationship-info),
        foreign-key,
        index(index-info),
        projection,
        trigger,
        x-data,
        storage,
        query,
        method(method-info),
        class-method(method-info),
        client-method(method-info),
    }

    enum index-subscript { keys, elements }

    // The `[ Type = ... ]` keyword; absent for a standard index. `key` is deprecated, but the
    // id key IRIS gives every persistent class has it.
    enum index-type { bitmap, bitslice, collated-key, columnar, key }

    // One `On` key: `property`, `property(KEYS)` or `property(ELEMENTS)`, each optionally `As collation`.
    record index-key {
        property: string,
        subscript: option<index-subscript>,
        collation: option<string>,
    }

    // `Index name On keys [ keywords ]`: the `On` clause when there is one, then every keyword
    // (https://docs.intersystems.com/iris20262/csp/docbook/DocBook.UI.Page.cls?KEY=ROBJ_index),
    // as declared: a flag is false and a value absent when the keyword is not given.
    record index-info {
        on: option<list<index-key>>,
        abstract: bool,
        // The expression, without its braces.
        condition: option<string>,
        coshard-with: option<string>,
        // The properties whose values the index also stores.
        data: list<string>,
        deferred: bool,
        extent: bool,
        id-key: bool,
        internal: bool,
        primary-key: bool,
        shard-key: bool,
        sql-name: option<string>,
        %type: option<index-type>,
        unique: bool,
    }

    record member-info {
        doc: string,
        before: position,
        name: name-info,
        aliases: list<string>,
        deprecated: bool,
        kind: member-kind,
        after: position,
        uri: option<string>,
        // The class declaring it; `none` in the workspace.
        origin: option<string>,
    }

    enum class-type { datatype, dynamic, index, literal, persistent, serial, %stream, view }

    // `[ Inheritance = right ]`: a member several superclasses define comes from the rightmost
    // `extends` entry rather than the leftmost.
    enum inheritance { left, right }

    enum language { objectscript, python, tsql, ispl, javascript }

    // A class as declared: its header, its own members, and the class keywords ascot reads
    // (https://docs.intersystems.com/iris20262/csp/docbook/DocBook.UI.Page.cls?KEY=ROBJ_class),
    // absent when not given. From IRIS the keywords are the compiled ones, defaults filled in.
    record class-info {
        doc: string,
        name: name-info,
        extends: list<string>,
        // The storage class a persistent class also inherits from (`%Storage.Persistent`), named by
        // its storage definition rather than `extends`.
        storage: option<string>,
        // Its own members only; ascot reaches the inherited ones through `extends` and `storage`,
        // and synthesizes the generated ones.
        members: list<member-info>,
        // Its own (not inherited) `Include` files; ascot unions them up `extends`.
        %include: list<string>,
        // A uri the host understands (e.g. `isfs://`), handed back for go-to-definition and hover.
        uri: option<string>,
        class-type: option<class-type>,
        deprecated: bool,
        inheritance: option<inheritance>,
        // The language of its methods unless they say otherwise; ObjectScript when absent.
        language: option<language>,
        // Whether each ObjectScript method is a procedure block unless it says otherwise; on by
        // default.
        procedure-block: option<bool>,
        // Its own (not inherited) `[ PropertyClass = ... ]` classes.
        property-class: list<string>,
    }

    record label-info {
        name: string,
        normal: list<normal-arg>,
        variadic: option<variadic-arg>,
        // The type of what it `Quit`s with, when known.
        t: option<string>,
        // A procedure's public list; `none` for a subroutine.
        procedure-block: option<list<string>>,
        declared-at: option<range>,
    }

    record routine-info {
        // Keyed by name; `none` if they aren't known (e.g. no source).
        labels: option<list<label-info>>,
        // Same meaning as `class-info.uri`.
        uri: option<string>,
    }

    record source {
        text: string,
        uri: option<string>,
    }

    enum keyword-form {
        long,
        short,
    }

    enum keyword-case {
        lower,
        upper,
        // As the documentation spells them: `Set`, `TStart`, `ZWrite`.
        pascal,
    }

    // How a command is written; a field left out allows either.
    record command-style {
        form: option<keyword-form>,
        case: option<keyword-case>,
        // On an argument (`Do ^R:x`) as well as on the keyword (`Do:x ^R`).
        allow-postcondition-on-argument: option<bool>,
    }

    // How an intrinsic function's name is written; a field left out allows either.
    record function-style {
        form: option<keyword-form>,
        case: option<keyword-case>,
    }

    enum and-operator {
        comma,
        double-ampersand,
    }

    // A field left out isn't checked. `command` applies to every command, and `command-<name>`
    // overrides it field by field for one; `function` and `function-<name>` do the same for
    // intrinsic functions.
    record style {
        // `Return` leaves a method or procedure; `Quit` is for loops and `Try` blocks.
        allow-quit-for-return: option<bool>,
        // How the conditions of `If`, `ElseIf` and `While` are joined.
        condition-and: option<and-operator>,
        max-new-per-block: option<u32>,
        max-commands-per-line: option<u32>,
        command: option<command-style>,
        command-do: option<command-style>,
        command-if: option<command-style>,
        command-elseif: option<command-style>,
        command-else: option<command-style>,
        command-while: option<command-style>,
        command-for: option<command-style>,
        command-goto: option<command-style>,
        command-break: option<command-style>,
        command-quit: option<command-style>,
        command-zquit: option<command-style>,
        command-return: option<command-style>,
        command-continue: option<command-style>,
        command-set: option<command-style>,
        command-kill: option<command-style>,
        command-new: option<command-style>,
        command-merge: option<command-style>,
        command-try: option<command-style>,
        command-catch: option<command-style>,
        command-throw: option<command-style>,
        command-ztrap: option<command-style>,
        command-zzdump: option<command-style>,
        command-write: option<command-style>,
        command-read: option<command-style>,
        command-open: option<command-style>,
        command-close: option<command-style>,
        command-use: option<command-style>,
        command-lock: option<command-style>,
        command-halt: option<command-style>,
        command-hang: option<command-style>,
        command-job: option<command-style>,
        command-tstart: option<command-style>,
        command-tcommit: option<command-style>,
        command-trollback: option<command-style>,
        command-zwrite: option<command-style>,
        command-zkill: option<command-style>,
        command-znspace: option<command-style>,
        command-xecute: option<command-style>,
        command-view: option<command-style>,
        command-zprint: option<command-style>,
        command-print: option<command-style>,
        command-zbreak: option<command-style>,
        command-mvprint: option<command-style>,
        command-mvcrt: option<command-style>,
        function: option<function-style>,
        function-ascii: option<function-style>,
        function-bit: option<function-style>,
        function-bitcount: option<function-style>,
        function-bitfind: option<function-style>,
        function-bitlogic: option<function-style>,
        function-case: option<function-style>,
        function-change: option<function-style>,
        function-char: option<function-style>,
        function-classmethod: option<function-style>,
        function-classname: option<function-style>,
        function-compile: option<function-style>,
        function-data: option<function-style>,
        function-decimal: option<function-style>,
        function-double: option<function-style>,
        function-extract: option<function-style>,
        function-factor: option<function-style>,
        function-find: option<function-style>,
        function-fnumber: option<function-style>,
        function-get: option<function-style>,
        function-increment: option<function-style>,
        function-inumber: option<function-style>,
        function-isobject: option<function-style>,
        function-isvaliddouble: option<function-style>,
        function-isvalidnum: option<function-style>,
        function-isvector: option<function-style>,
        function-justify: option<function-style>,
        function-length: option<function-style>,
        function-list: option<function-style>,
        function-listbuild: option<function-style>,
        function-listdata: option<function-style>,
        function-listfind: option<function-style>,
        function-listfromstring: option<function-style>,
        function-listget: option<function-style>,
        function-listlength: option<function-style>,
        function-listnext: option<function-style>,
        function-listsame: option<function-style>,
        function-listtostring: option<function-style>,
        function-listupdate: option<function-style>,
        function-listvalid: option<function-style>,
        function-locate: option<function-style>,
        function-lock: option<function-style>,
        function-match: option<function-style>,
        function-method: option<function-style>,
        function-mv: option<function-style>,
        function-mvv: option<function-style>,
        function-name: option<function-style>,
        function-nconvert: option<function-style>,
        function-next: option<function-style>,
        function-normalize: option<function-style>,
        function-now: option<function-style>,
        function-number: option<function-style>,
        function-order: option<function-style>,
        function-parameter: option<function-style>,
        function-piece: option<function-style>,
        function-prefetchoff: option<function-style>,
        function-prefetchon: option<function-style>,
        function-property: option<function-style>,
        function-qlength: option<function-style>,
        function-qsubscript: option<function-style>,
        function-query: option<function-style>,
        function-random: option<function-style>,
        function-replace: option<function-style>,
        function-reverse: option<function-style>,
        function-sconvert: option<function-style>,
        function-select: option<function-style>,
        function-sequence: option<function-style>,
        function-sortbegin: option<function-style>,
        function-sortend: option<function-style>,
        function-stack: option<function-style>,
        function-text: option<function-style>,
        function-translate: option<function-style>,
        function-vector: option<function-style>,
        function-vectordefined: option<function-style>,
        function-vectorop: option<function-style>,
        function-view: option<function-style>,
        function-wascii: option<function-style>,
        function-wchar: option<function-style>,
        function-wextract: option<function-style>,
        function-wfind: option<function-style>,
        function-wiswide: option<function-style>,
        function-wlength: option<function-style>,
        function-wreverse: option<function-style>,
        function-xecute: option<function-style>,
        function-zabs: option<function-style>,
        function-zarccos: option<function-style>,
        function-zarcsin: option<function-style>,
        function-zarctan: option<function-style>,
        function-zbitand: option<function-style>,
        function-zbitcount: option<function-style>,
        function-zbitfind: option<function-style>,
        function-zbitget: option<function-style>,
        function-zbitlen: option<function-style>,
        function-zbitnot: option<function-style>,
        function-zbitor: option<function-style>,
        function-zbitset: option<function-style>,
        function-zbitstr: option<function-style>,
        function-zbitxor: option<function-style>,
        function-zboolean: option<function-style>,
        function-zconvert: option<function-style>,
        function-zcos: option<function-style>,
        function-zcot: option<function-style>,
        function-zcrc: option<function-style>,
        function-zcsc: option<function-style>,
        function-zcyc: option<function-style>,
        function-zdascii: option<function-style>,
        function-zdate: option<function-style>,
        function-zdateh: option<function-style>,
        function-zdatetime: option<function-style>,
        function-zdatetimeh: option<function-style>,
        function-zdchar: option<function-style>,
        function-zexp: option<function-style>,
        function-zf: option<function-style>,
        function-zhex: option<function-style>,
        function-zincrement: option<function-style>,
        function-ziswide: option<function-style>,
        function-zlascii: option<function-style>,
        function-zlchar: option<function-style>,
        function-zln: option<function-style>,
        function-zlog: option<function-style>,
        function-zname: option<function-style>,
        function-zobjclass: option<function-style>,
        function-zobjclassmethod: option<function-style>,
        function-zobjmethod: option<function-style>,
        function-zobjproperty: option<function-style>,
        function-zobjref: option<function-style>,
        function-zorder: option<function-style>,
        function-zposition: option<function-style>,
        function-zpower: option<function-style>,
        function-zprevious: option<function-style>,
        function-zqascii: option<function-style>,
        function-zqchar: option<function-style>,
        function-zsearch: option<function-style>,
        function-zsec: option<function-style>,
        function-zseek: option<function-style>,
        function-zsin: option<function-style>,
        function-zsqr: option<function-style>,
        function-zstrip: option<function-style>,
        function-ztan: option<function-style>,
        function-ztime: option<function-style>,
        function-ztimeh: option<function-style>,
        function-zutil: option<function-style>,
        function-zversion: option<function-style>,
        function-zwascii: option<function-style>,
        function-zwbpack: option<function-style>,
        function-zwbunpack: option<function-style>,
        function-zwchar: option<function-style>,
        function-zwidth: option<function-style>,
        function-zwpack: option<function-style>,
        function-zwunpack: option<function-style>,
        function-zzenkaku: option<function-style>,
    }

    enum diagnostic-severity {
        error,
        warning,
        information,
        hint,
    }

    record diagnostic {
        message: string,
        range: range,
        related-information: list<diagnostic-related-information>,
        severity: diagnostic-severity,
        // A fixed id for the kind of finding, e.g. `A1234`.
        code: string,
        // The kind's documentation: a docs.rs url for the running version.
        code-description: string,
    }

    record inlay-hint {
        position: position,
        label: string,
        padding-left: bool,
        padding-right: bool,
    }

    enum symbol-kind {
        class,
        // A routine, which has no enclosing class.
        module,
        method,
        property,
        %interface,
        function,
        constant,
        array,
        object,
        key,
        %struct,
        event,
    }

    record symbol-info {
        name: string,
        kind: symbol-kind,
        deprecated: bool,
        range: range,
        selection-range: range,
    }

    // A `textDocument/documentSymbol` outline: the document's class or routine, and its members or
    // labels. Flat, since a WIT record can't contain itself.
    record document-symbol {
        root: symbol-info,
        members: list<symbol-info>,
    }

    record workspace-symbol {
        name: string,
        kind: symbol-kind,
        deprecated: bool,
        location: location,
    }
}

interface imported {
    use common.{class-info, routine-info, source};

    resource iris-context {
        get-cls: func(name: string) -> result<option<class-info>, string>;
        get-rtn: func(name: string) -> result<option<routine-info>, string>;
        get-inc: func(name: string) -> result<option<source>, string>;
    }

    // The two Atelier REST API requests, for ascot to make `iris-context`'s lookups with.
    resource atelier {
        // The rows of `/action/query` as a JSON array, each an object keyed by column name.
        query: func(sql: string, params: list<string>) -> result<string, string>;
        // The text of `/doc/{name}`; `none` if there's no such document.
        get-doc: func(name: string) -> result<option<string>, string>;
    }

    variant env {
        context(iris-context),
        atelier(atelier),
    }
}

interface exported {
    use common.{
        member-info, class-info, position,
        diagnostic, inlay-hint, range, location,
        document-symbol, workspace-symbol, style,
    };
    use imported.{env};

    resource workspace {
        constructor(env: option<env>, style: option<style>);
        // Open or edit (kind from `uri`'s extension); returns the uris now stale.
        open: func(uri: string, text: string) -> list<string>;
        // Returns the uris now stale.
        close: func(uri: string) -> list<string>;
        // Replaces the server everything outside the workspace resolves through; returns every
        // uri, since all analysis built on the old one is stale.
        set-env: func(env: option<env>) -> list<string>;
        // Replaces the keyword style; returns every uri, since every check applied the old one.
        set-style: func(style: option<style>) -> list<string>;
        diagnostics: func(uri: string) -> list<diagnostic>;
        inlay-hint: func(uri: string, range: range) -> list<inlay-hint>;
        definition: func(uri: string, position: position) -> option<location>;
        references: func(uri: string, position: position, include-declaration: bool) -> list<location>;
        hover: func(uri: string, position: position) -> option<string>;
        query-cls: func(query: string) -> list<tuple<string, class-info>>;
        query-mem: func(cls: string, query: string) -> list<tuple<string, member-info>>;
        document-symbol: func(uri: string) -> option<document-symbol>;
        workspace-symbol: func(query: string) -> list<workspace-symbol>;
    }
}

world ascot {
    import imported;
    export exported;
}
