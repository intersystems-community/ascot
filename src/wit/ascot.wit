package iris:ascot;

interface common {

    record position {
        line: u32,
        character: u32,
    }

    record range {
        start: position,
        end: position,
    }

    record location {
        uri: string,
        range: range,
    }

    record diagnostic-related-information {
        location: location,
        message: string,
    }

    // How a parameter is passed by reference; `none` is by value.
    enum ref-mode {
        by-ref,
        // No value is expected to come in.
        output,
    }

    record normal-arg {
        mode: option<ref-mode>,
        name: string,
        t: option<string>,
        default: option<string>,
    }

    record variadic-arg {
        mode: option<ref-mode>,
        name: string,
        t: option<string>,
    }

    // A method's or a label's formal list and what it returns.
    record signature {
        normal: list<normal-arg>,
        variadic: option<variadic-arg>,
        t: option<string>,
        // A procedure's public list; `none` for a subroutine.
        procedure-block: option<list<string>>,
    }

    record parameter-info {
        t: option<string>,
        v: option<string>
    }

    enum collection-kind { %list, array }

    // `t` is the element type for a `list Of`/`array Of` property.
    record property-info {
        t: option<string>,
        collection: option<collection-kind>,
        multidimensional: bool,
    }

    enum cardinality { one, many, parent, children }

    // `t` is the related class.
    record relationship-info {
        t: option<string>,
        cardinality: option<cardinality>,
    }

    variant member-kind {
        parameter(parameter-info),
        property(property-info),
        relationship(relationship-info),
        foreign-key,
        index(index-info),
        projection,
        trigger,
        x-data,
        storage,
        // The query's own arguments and its class; IRIS generates its methods from them.
        query(signature),
        method(signature),
        class-method(signature),
        client-method(signature),
    }

    enum index-subscript { keys, elements }

    // The `[ Type = ... ]` keyword; absent for a standard index. `key` is deprecated, but the
    // id key IRIS gives every persistent class has it.
    enum index-type { bitmap, bitslice, collated-key, columnar, key }

    // One `On` key: `property`, `property(KEYS)` or `property(ELEMENTS)`, each optionally `As collation`.
    record index-key {
        property: string,
        subscript: option<index-subscript>,
        collation: option<string>,
    }

    // `Index name On keys [ keywords ]`: the `On` clause when there is one, then every keyword
    // (https://docs.intersystems.com/iris20262/csp/docbook/DocBook.UI.Page.cls?KEY=ROBJ_index),
    // as declared: a flag is false and a value absent when the keyword is not given.
    record index-info {
        on: option<list<index-key>>,
        abstract: bool,
        // The expression, without its braces.
        condition: option<string>,
        coshard-with: option<string>,
        // The properties whose values the index also stores.
        data: list<string>,
        deferred: bool,
        extent: bool,
        id-key: bool,
        internal: bool,
        primary-key: bool,
        shard-key: bool,
        sql-name: option<string>,
        %type: option<index-type>,
        unique: bool,
    }

    record member-info {
        doc: string,
        name: string,
        aliases: list<string>,
        deprecated: bool,
        kind: member-kind,
        uri: option<string>,
        // The class declaring it; `none` in the workspace.
        origin: option<string>,
    }

    enum class-type { datatype, dynamic, index, literal, persistent, serial, %stream, view }

    // `[ Inheritance = right ]`: a member several superclasses define comes from the rightmost
    // `extends` entry rather than the leftmost.
    enum inheritance { left, right }

    enum language { objectscript, python, tsql, ispl, javascript, mvbasic }

    // A class as declared: its header, its own members, and the class keywords ascot reads
    // (https://docs.intersystems.com/iris20262/csp/docbook/DocBook.UI.Page.cls?KEY=ROBJ_class),
    // absent when not given. From IRIS the keywords are the compiled ones, defaults filled in.
    record class-info {
        doc: string,
        name: string,
        extends: list<string>,
        // The storage class a persistent class also inherits from (`%Storage.Persistent`), named by
        // its storage definition rather than `extends`.
        storage: option<string>,
        // Its own members only; ascot reaches the inherited ones through `extends` and `storage`,
        // and synthesizes the generated ones.
        members: list<member-info>,
        // Its own (not inherited) `Include` files; ascot unions them up `extends`.
        %include: list<string>,
        // Its own (not inherited) `Import` packages; ascot unions them up `extends` to resolve a
        // short class name.
        %import: option<list<string>>,
        // A uri the host understands (e.g. `isfs://`), handed back for go-to-definition and hover.
        uri: option<string>,
        class-type: option<class-type>,
        deprecated: bool,
        // `[ Abstract ]`: never instantiated itself, so a value of this type is some subclass's.
        abstract: bool,
        inheritance: option<inheritance>,
        // The language of its methods unless they say otherwise; ObjectScript when absent.
        language: option<language>,
        // Whether each ObjectScript method is a procedure block unless it says otherwise; on by
        // default.
        procedure-block: option<bool>,
        // Its own (not inherited) `[ PropertyClass = ... ]` classes.
        property-class: list<string>,
    }

    record label-info {
        name: string,
        // `none` when only the name is known, as from compiled code.
        signature: option<signature>,
    }

    record routine-info {
        // Keyed by name; `none` if they aren't known (e.g. no source).
        labels: option<list<label-info>>,
        // Same meaning as `class-info.uri`.
        uri: option<string>,
    }

    record source {
        text: string,
        uri: option<string>,
    }

    enum keyword-form {
        long,
        short,
    }

    enum keyword-case {
        lower,
        upper,
        // As the documentation spells them: `Set`, `TStart`, `ZWrite`.
        pascal,
    }

    // How a command is written; a field left out allows either.
    record command-style {
        form: option<keyword-form>,
        case: option<keyword-case>,
        // On an argument (`Do ^R:x`) as well as on the keyword (`Do:x ^R`).
        allow-postcondition-on-argument: option<bool>,
    }

    // How an intrinsic function's or system variable's name is written; a field left out allows
    // either.
    record keyword-style {
        form: option<keyword-form>,
        case: option<keyword-case>,
    }

    enum and-operator {
        comma,
        double-ampersand,
    }

    // Whether a line break is required (`true`) or forbidden (`false`) on each side of a brace; a
    // field left out allows either.
    record brace-breaks {
        newline-before: option<bool>,
        newline-after: option<bool>,
    }

    record require-description {
        // A method, or a routine label with a parameter list, whose body has at least this many
        // lines must carry a description: `///` lines right above the method, comment lines right
        // above the label. `0` means every one. Private methods are exempt.
        min-body-lines: u32,
    }

    // A field left out isn't checked. `command` applies to every command, and `command-<name>`
    // overrides it field by field for one; `function` and `function-<name>` do the same for
    // intrinsic functions, `variable` and `variable-<name>` for system variables.
    record style {
        // `Return` leaves a method or procedure; `Quit` is for loops and `Try` blocks.
        allow-quit-for-return: option<bool>,
        // How the conditions of `If`, `ElseIf` and `While` are joined.
        condition-and: option<and-operator>,
        max-new-per-block: option<u32>,
        max-commands-per-line: option<u32>,
        require-description: option<require-description>,
        // Around a block's `{`: between the command and it, and between it and the block's first
        // command.
        open-brace: option<brace-breaks>,
        // Around a block's `}`: between the block's last command and it, and between it and an
        // `Else`, `ElseIf` or `Catch` that follows.
        close-brace: option<brace-breaks>,
        // One space after a comma and none before (`true`), or none on either side (`false`).
        space-after-comma: option<bool>,
        command: option<command-style>,
        command-do: option<command-style>,
        command-if: option<command-style>,
        command-elseif: option<command-style>,
        command-else: option<command-style>,
        command-while: option<command-style>,
        command-for: option<command-style>,
        command-goto: option<command-style>,
        command-break: option<command-style>,
        command-quit: option<command-style>,
        command-zquit: option<command-style>,
        command-return: option<command-style>,
        command-continue: option<command-style>,
        command-set: option<command-style>,
        command-kill: option<command-style>,
        command-new: option<command-style>,
        command-merge: option<command-style>,
        command-try: option<command-style>,
        command-catch: option<command-style>,
        command-throw: option<command-style>,
        command-ztrap: option<command-style>,
        command-zzdump: option<command-style>,
        command-write: option<command-style>,
        command-read: option<command-style>,
        command-open: option<command-style>,
        command-close: option<command-style>,
        command-use: option<command-style>,
        command-lock: option<command-style>,
        command-halt: option<command-style>,
        command-hang: option<command-style>,
        command-job: option<command-style>,
        command-tstart: option<command-style>,
        command-tcommit: option<command-style>,
        command-trollback: option<command-style>,
        command-zwrite: option<command-style>,
        command-zkill: option<command-style>,
        command-znspace: option<command-style>,
        command-xecute: option<command-style>,
        command-view: option<command-style>,
        command-zprint: option<command-style>,
        command-print: option<command-style>,
        command-zbreak: option<command-style>,
        command-mvprint: option<command-style>,
        command-mvcrt: option<command-style>,
        function: option<keyword-style>,
        function-ascii: option<keyword-style>,
        function-bit: option<keyword-style>,
        function-bitcount: option<keyword-style>,
        function-bitfind: option<keyword-style>,
        function-bitlogic: option<keyword-style>,
        function-case: option<keyword-style>,
        function-change: option<keyword-style>,
        function-char: option<keyword-style>,
        function-classmethod: option<keyword-style>,
        function-classname: option<keyword-style>,
        function-compile: option<keyword-style>,
        function-data: option<keyword-style>,
        function-decimal: option<keyword-style>,
        function-double: option<keyword-style>,
        function-extract: option<keyword-style>,
        function-factor: option<keyword-style>,
        function-find: option<keyword-style>,
        function-fnumber: option<keyword-style>,
        function-get: option<keyword-style>,
        function-increment: option<keyword-style>,
        function-inumber: option<keyword-style>,
        function-isobject: option<keyword-style>,
        function-isvaliddouble: option<keyword-style>,
        function-isvalidnum: option<keyword-style>,
        function-isvector: option<keyword-style>,
        function-justify: option<keyword-style>,
        function-length: option<keyword-style>,
        function-list: option<keyword-style>,
        function-listbuild: option<keyword-style>,
        function-listdata: option<keyword-style>,
        function-listfind: option<keyword-style>,
        function-listfromstring: option<keyword-style>,
        function-listget: option<keyword-style>,
        function-listlength: option<keyword-style>,
        function-listnext: option<keyword-style>,
        function-listsame: option<keyword-style>,
        function-listtostring: option<keyword-style>,
        function-listupdate: option<keyword-style>,
        function-listvalid: option<keyword-style>,
        function-locate: option<keyword-style>,
        function-lock: option<keyword-style>,
        function-match: option<keyword-style>,
        function-method: option<keyword-style>,
        function-mv: option<keyword-style>,
        function-mvv: option<keyword-style>,
        function-name: option<keyword-style>,
        function-nconvert: option<keyword-style>,
        function-next: option<keyword-style>,
        function-normalize: option<keyword-style>,
        function-now: option<keyword-style>,
        function-number: option<keyword-style>,
        function-order: option<keyword-style>,
        function-parameter: option<keyword-style>,
        function-piece: option<keyword-style>,
        function-prefetchoff: option<keyword-style>,
        function-prefetchon: option<keyword-style>,
        function-property: option<keyword-style>,
        function-qlength: option<keyword-style>,
        function-qsubscript: option<keyword-style>,
        function-query: option<keyword-style>,
        function-random: option<keyword-style>,
        function-replace: option<keyword-style>,
        function-reverse: option<keyword-style>,
        function-sconvert: option<keyword-style>,
        function-select: option<keyword-style>,
        function-sequence: option<keyword-style>,
        function-sortbegin: option<keyword-style>,
        function-sortend: option<keyword-style>,
        function-stack: option<keyword-style>,
        function-text: option<keyword-style>,
        function-translate: option<keyword-style>,
        function-vector: option<keyword-style>,
        function-vectordefined: option<keyword-style>,
        function-vectorop: option<keyword-style>,
        function-view: option<keyword-style>,
        function-wascii: option<keyword-style>,
        function-wchar: option<keyword-style>,
        function-wextract: option<keyword-style>,
        function-wfind: option<keyword-style>,
        function-wiswide: option<keyword-style>,
        function-wlength: option<keyword-style>,
        function-wreverse: option<keyword-style>,
        function-xecute: option<keyword-style>,
        function-zabs: option<keyword-style>,
        function-zarccos: option<keyword-style>,
        function-zarcsin: option<keyword-style>,
        function-zarctan: option<keyword-style>,
        function-zbitand: option<keyword-style>,
        function-zbitcount: option<keyword-style>,
        function-zbitfind: option<keyword-style>,
        function-zbitget: option<keyword-style>,
        function-zbitlen: option<keyword-style>,
        function-zbitnot: option<keyword-style>,
        function-zbitor: option<keyword-style>,
        function-zbitset: option<keyword-style>,
        function-zbitstr: option<keyword-style>,
        function-zbitxor: option<keyword-style>,
        function-zboolean: option<keyword-style>,
        function-zconvert: option<keyword-style>,
        function-zcos: option<keyword-style>,
        function-zcot: option<keyword-style>,
        function-zcrc: option<keyword-style>,
        function-zcsc: option<keyword-style>,
        function-zcyc: option<keyword-style>,
        function-zdascii: option<keyword-style>,
        function-zdate: option<keyword-style>,
        function-zdateh: option<keyword-style>,
        function-zdatetime: option<keyword-style>,
        function-zdatetimeh: option<keyword-style>,
        function-zdchar: option<keyword-style>,
        function-zexp: option<keyword-style>,
        function-zf: option<keyword-style>,
        function-zhex: option<keyword-style>,
        function-zincrement: option<keyword-style>,
        function-ziswide: option<keyword-style>,
        function-zlascii: option<keyword-style>,
        function-zlchar: option<keyword-style>,
        function-zln: option<keyword-style>,
        function-zlog: option<keyword-style>,
        function-zname: option<keyword-style>,
        function-zobjclass: option<keyword-style>,
        function-zobjclassmethod: option<keyword-style>,
        function-zobjmethod: option<keyword-style>,
        function-zobjproperty: option<keyword-style>,
        function-zobjref: option<keyword-style>,
        function-zorder: option<keyword-style>,
        function-zposition: option<keyword-style>,
        function-zpower: option<keyword-style>,
        function-zprevious: option<keyword-style>,
        function-zqascii: option<keyword-style>,
        function-zqchar: option<keyword-style>,
        function-zsearch: option<keyword-style>,
        function-zsec: option<keyword-style>,
        function-zseek: option<keyword-style>,
        function-zsin: option<keyword-style>,
        function-zsqr: option<keyword-style>,
        function-zstrip: option<keyword-style>,
        function-ztan: option<keyword-style>,
        function-ztime: option<keyword-style>,
        function-ztimeh: option<keyword-style>,
        function-zutil: option<keyword-style>,
        function-zversion: option<keyword-style>,
        function-zwascii: option<keyword-style>,
        function-zwbpack: option<keyword-style>,
        function-zwbunpack: option<keyword-style>,
        function-zwchar: option<keyword-style>,
        function-zwidth: option<keyword-style>,
        function-zwpack: option<keyword-style>,
        function-zwunpack: option<keyword-style>,
        function-zzenkaku: option<keyword-style>,
        variable: option<keyword-style>,
        variable-device: option<keyword-style>,
        variable-estack: option<keyword-style>,
        variable-etrap: option<keyword-style>,
        variable-ecode: option<keyword-style>,
        variable-halt: option<keyword-style>,
        variable-horolog: option<keyword-style>,
        variable-io: option<keyword-style>,
        variable-job: option<keyword-style>,
        variable-key: option<keyword-style>,
        variable-mvsysretcode: option<keyword-style>,
        variable-mvam: option<keyword-style>,
        variable-mvvm: option<keyword-style>,
        variable-mvsm: option<keyword-style>,
        variable-namespace: option<keyword-style>,
        variable-principal: option<keyword-style>,
        variable-quit: option<keyword-style>,
        variable-roles: option<keyword-style>,
        variable-stack: option<keyword-style>,
        variable-system: option<keyword-style>,
        variable-storage: option<keyword-style>,
        variable-throwobj: option<keyword-style>,
        variable-tlevel: option<keyword-style>,
        variable-this: option<keyword-style>,
        variable-trs: option<keyword-style>,
        variable-tid: option<keyword-style>,
        variable-test: option<keyword-style>,
        variable-username: option<keyword-style>,
        variable-x: option<keyword-style>,
        variable-y: option<keyword-style>,
        variable-zchild: option<keyword-style>,
        variable-zeof: option<keyword-style>,
        variable-zeos: option<keyword-style>,
        variable-zerror: option<keyword-style>,
        variable-zhorolog: option<keyword-style>,
        variable-zio: option<keyword-style>,
        variable-zjob: option<keyword-style>,
        variable-zmode: option<keyword-style>,
        variable-zname: option<keyword-style>,
        variable-znspace: option<keyword-style>,
        variable-zorder: option<keyword-style>,
        variable-zparent: option<keyword-style>,
        variable-zpi: option<keyword-style>,
        variable-zposition: option<keyword-style>,
        variable-zreference: option<keyword-style>,
        variable-zstorage: option<keyword-style>,
        variable-ztimestamp: option<keyword-style>,
        variable-ztimezone: option<keyword-style>,
        variable-ztrap: option<keyword-style>,
        variable-zversion: option<keyword-style>,
        variable-za: option<keyword-style>,
        variable-zb: option<keyword-style>,
    }

    enum diagnostic-severity {
        error,
        warning,
        information,
        hint,
    }

    record diagnostic {
        message: string,
        range: range,
        related-information: list<diagnostic-related-information>,
        severity: diagnostic-severity,
        // A fixed id for the kind of finding, e.g. `A1234`.
        code: string,
        // The kind's documentation: a docs.rs url for the running version.
        code-description: string,
    }

    record inlay-hint {
        position: position,
        label: string,
        padding-left: bool,
        padding-right: bool,
    }

    enum symbol-kind {
        class,
        // A routine, which has no enclosing class.
        module,
        method,
        property,
        %interface,
        function,
        constant,
        array,
        object,
        key,
        %struct,
        event,
    }

    record symbol-info {
        name: string,
        kind: symbol-kind,
        deprecated: bool,
        range: range,
        selection-range: range,
    }

    // A `textDocument/documentSymbol` outline: the document's class or routine, and its members or
    // labels. Flat, since a WIT record can't contain itself.
    record document-symbol {
        root: symbol-info,
        members: list<symbol-info>,
    }

    record workspace-symbol {
        name: string,
        kind: symbol-kind,
        deprecated: bool,
        location: location,
        // LSP's `containerName`, shown after the name: the member's keyword and its class, as
        // `ClassMethod • Demo.Lib`, or `Label` and its routine; none for the class or routine itself.
        container-name: option<string>,
    }
}

interface imported {
    use common.{class-info, routine-info, source};

    resource iris-context {
        get-cls: func(name: string) -> result<option<class-info>, string>;
        get-rtn: func(name: string) -> result<option<routine-info>, string>;
        get-inc: func(name: string) -> result<option<source>, string>;
    }

    // The two Atelier REST API requests, for ascot to make `iris-context`'s lookups with.
    resource atelier {
        // The rows of `/action/query` as a JSON array, each an object keyed by column name.
        query: func(sql: string, params: list<string>) -> result<string, string>;
        // The text of `/doc/{name}`; `none` if there's no such document.
        get-doc: func(name: string) -> result<option<string>, string>;
    }

    variant env {
        context(iris-context),
        atelier(atelier),
        // A declaration file's content, gzipped or not: what `ascot declare` writes, or a release's
        // pre-built asset as the host bundles it.
        declarations(list<u8>),
    }
}

interface exported {
    use common.{
        member-info, class-info, position,
        diagnostic, inlay-hint, range, location,
        document-symbol, workspace-symbol, style,
    };
    use imported.{env};

    resource workspace {
        constructor(env: option<env>, style: option<style>);
        // Open or edit (kind from `uri`'s extension); returns the uris now stale.
        open: func(uri: string, text: string) -> list<string>;
        // Returns the uris now stale.
        close: func(uri: string) -> list<string>;
        // Replaces the server everything outside the workspace resolves through; returns every
        // uri, since all analysis built on the old one is stale.
        set-env: func(env: option<env>) -> list<string>;
        // Replaces the keyword style; returns every uri, since every check applied the old one.
        set-style: func(style: option<style>) -> list<string>;
        // Replaces which codes `diagnostics` reports, and at what severity: `VERB:TARGETS` values
        // applied in order, as `ascot analyze -d` takes them; returns every uri, since every
        // report may change. An invalid value is the error, and the filter stays as it was.
        set-diagnostics: func(diagnostics: list<string>) -> result<list<string>, string>;
        diagnostics: func(uri: string) -> list<diagnostic>;
        inlay-hint: func(uri: string, range: range) -> list<inlay-hint>;
        definition: func(uri: string, position: position) -> option<location>;
        references: func(uri: string, position: position, include-declaration: bool) -> list<location>;
        hover: func(uri: string, position: position) -> option<string>;
        query-cls: func(query: string) -> list<tuple<string, class-info>>;
        query-mem: func(cls: string, query: string) -> list<tuple<string, member-info>>;
        document-symbol: func(uri: string) -> option<document-symbol>;
        workspace-symbol: func(query: string) -> list<workspace-symbol>;
    }
}

world ascot {
    import imported;
    export exported;
}
