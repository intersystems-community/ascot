package iris:ascot;

interface common {

    record position {
        line: u32,
        character: u32,
    }

    record range {
        start: position,
        end: position,
    }

    record location {
        uri: string,
        range: range,
    }

    record diagnostic-related-information {
        location: location,
        message: string,
    }

    record name-info {
        before: position,
        content: string,
        after: position,
    }

    enum arg-mode {
        default,
        output,
        by-ref,
    }

    record normal-arg {
        mode: arg-mode,
        name: string,
        t: option<string>,
        default: option<string>,
        declared-at: option<range>,
    }

    record variadic-arg {
        mode: arg-mode,
        name: string,
        t: option<string>,
        declared-at: option<range>,
    }

    record method-info {
        normal: list<normal-arg>,
        variadic: option<variadic-arg>,
        t: option<string>,
        procedure-block: option<list<string>>,
        body: range,
    }

    record parameter-info {
        t: option<string>,
        v: option<string>
    }

    enum collection-kind { %list, array }

    // `t` is the element type for a `list Of`/`array Of` property.
    record property-info {
        t: option<string>,
        collection: option<collection-kind>,
        multidimensional: bool,
    }

    enum cardinality { one, many, parent, children }

    // `t` is the related class.
    record relationship-info {
        t: option<string>,
        cardinality: option<cardinality>,
    }

    variant member-kind {
        parameter(parameter-info),
        property(property-info),
        relationship(relationship-info),
        foreign-key,
        index,
        projection,
        trigger,
        x-data,
        storage,
        query,
        method(method-info),
        class-method(method-info),
        client-method(method-info),
    }

    record member-info {
        doc: string,
        before: position,
        name: name-info,
        aliases: list<string>,
        deprecated: bool,
        kind: member-kind,
        after: position,
        uri: option<string>,
        // The class declaring it, to tell an override of an IRIS hook from an inherited stub;
        // `none` in the workspace.
        origin: option<string>,
    }

    record class-info {
        doc: string,
        name: name-info,
        extends: list<string>,
        deprecated: bool,
        members: list<member-info>,
        // Its own (not inherited) `[PropertyClass = ...]` classes.
        property-class-names: list<string>,
        // Its own (not inherited) `Include` files; ascot unions them up `extends`.
        includes: list<string>,
        // `none` when unknown.
        is-datatype: option<bool>,
        // A uri the host understands (e.g. `isfs://`), handed back for go-to-definition and hover.
        uri: option<string>,
    }

    record label-info {
        name: string,
        normal: list<normal-arg>,
        variadic: option<variadic-arg>,
        // The type of what it `Quit`s with, when known.
        t: option<string>,
        // A procedure's public list; `none` for a subroutine.
        procedure-block: option<list<string>>,
        declared-at: option<range>,
    }

    record routine-info {
        // Keyed by name; `none` if they aren't known (e.g. no source).
        labels: option<list<label-info>>,
        // Same meaning as `class-info.uri`.
        uri: option<string>,
    }

    record source {
        text: string,
        uri: option<string>,
    }

    enum keyword-form {
        long,
        short,
    }

    enum keyword-case {
        lower,
        upper,
        // As the documentation spells them: `Set`, `TStart`, `ZWrite`.
        pascal,
    }

    // How a command or function name is written; a field left out allows either.
    record keyword-style {
        form: option<keyword-form>,
        case: option<keyword-case>,
    }

    // `command` applies to every command, and `command-<name>` overrides it field by field for one;
    // `function` and `function-<name>` do the same for intrinsic functions.
    record style {
        command: option<keyword-style>,
        command-do: option<keyword-style>,
        command-if: option<keyword-style>,
        command-elseif: option<keyword-style>,
        command-else: option<keyword-style>,
        command-while: option<keyword-style>,
        command-for: option<keyword-style>,
        command-goto: option<keyword-style>,
        command-break: option<keyword-style>,
        command-quit: option<keyword-style>,
        command-zquit: option<keyword-style>,
        command-return: option<keyword-style>,
        command-continue: option<keyword-style>,
        command-set: option<keyword-style>,
        command-kill: option<keyword-style>,
        command-new: option<keyword-style>,
        command-merge: option<keyword-style>,
        command-try: option<keyword-style>,
        command-catch: option<keyword-style>,
        command-throw: option<keyword-style>,
        command-ztrap: option<keyword-style>,
        command-zzdump: option<keyword-style>,
        command-write: option<keyword-style>,
        command-read: option<keyword-style>,
        command-open: option<keyword-style>,
        command-close: option<keyword-style>,
        command-use: option<keyword-style>,
        command-lock: option<keyword-style>,
        command-halt: option<keyword-style>,
        command-hang: option<keyword-style>,
        command-job: option<keyword-style>,
        command-tstart: option<keyword-style>,
        command-tcommit: option<keyword-style>,
        command-trollback: option<keyword-style>,
        command-zwrite: option<keyword-style>,
        command-zkill: option<keyword-style>,
        command-znspace: option<keyword-style>,
        command-xecute: option<keyword-style>,
        command-view: option<keyword-style>,
        command-zprint: option<keyword-style>,
        command-print: option<keyword-style>,
        command-zbreak: option<keyword-style>,
        command-mvprint: option<keyword-style>,
        command-mvcrt: option<keyword-style>,
        function: option<keyword-style>,
        function-ascii: option<keyword-style>,
        function-bit: option<keyword-style>,
        function-bitcount: option<keyword-style>,
        function-bitfind: option<keyword-style>,
        function-bitlogic: option<keyword-style>,
        function-case: option<keyword-style>,
        function-change: option<keyword-style>,
        function-char: option<keyword-style>,
        function-classmethod: option<keyword-style>,
        function-classname: option<keyword-style>,
        function-compile: option<keyword-style>,
        function-data: option<keyword-style>,
        function-decimal: option<keyword-style>,
        function-double: option<keyword-style>,
        function-extract: option<keyword-style>,
        function-factor: option<keyword-style>,
        function-find: option<keyword-style>,
        function-fnumber: option<keyword-style>,
        function-get: option<keyword-style>,
        function-increment: option<keyword-style>,
        function-inumber: option<keyword-style>,
        function-isobject: option<keyword-style>,
        function-isvaliddouble: option<keyword-style>,
        function-isvalidnum: option<keyword-style>,
        function-isvector: option<keyword-style>,
        function-justify: option<keyword-style>,
        function-length: option<keyword-style>,
        function-list: option<keyword-style>,
        function-listbuild: option<keyword-style>,
        function-listdata: option<keyword-style>,
        function-listfind: option<keyword-style>,
        function-listfromstring: option<keyword-style>,
        function-listget: option<keyword-style>,
        function-listlength: option<keyword-style>,
        function-listnext: option<keyword-style>,
        function-listsame: option<keyword-style>,
        function-listtostring: option<keyword-style>,
        function-listupdate: option<keyword-style>,
        function-listvalid: option<keyword-style>,
        function-locate: option<keyword-style>,
        function-lock: option<keyword-style>,
        function-match: option<keyword-style>,
        function-method: option<keyword-style>,
        function-mv: option<keyword-style>,
        function-mvv: option<keyword-style>,
        function-name: option<keyword-style>,
        function-nconvert: option<keyword-style>,
        function-next: option<keyword-style>,
        function-normalize: option<keyword-style>,
        function-now: option<keyword-style>,
        function-number: option<keyword-style>,
        function-order: option<keyword-style>,
        function-parameter: option<keyword-style>,
        function-piece: option<keyword-style>,
        function-prefetchoff: option<keyword-style>,
        function-prefetchon: option<keyword-style>,
        function-property: option<keyword-style>,
        function-qlength: option<keyword-style>,
        function-qsubscript: option<keyword-style>,
        function-query: option<keyword-style>,
        function-random: option<keyword-style>,
        function-replace: option<keyword-style>,
        function-reverse: option<keyword-style>,
        function-sconvert: option<keyword-style>,
        function-select: option<keyword-style>,
        function-sequence: option<keyword-style>,
        function-sortbegin: option<keyword-style>,
        function-sortend: option<keyword-style>,
        function-stack: option<keyword-style>,
        function-text: option<keyword-style>,
        function-translate: option<keyword-style>,
        function-vector: option<keyword-style>,
        function-vectordefined: option<keyword-style>,
        function-vectorop: option<keyword-style>,
        function-view: option<keyword-style>,
        function-wascii: option<keyword-style>,
        function-wchar: option<keyword-style>,
        function-wextract: option<keyword-style>,
        function-wfind: option<keyword-style>,
        function-wiswide: option<keyword-style>,
        function-wlength: option<keyword-style>,
        function-wreverse: option<keyword-style>,
        function-xecute: option<keyword-style>,
        function-zabs: option<keyword-style>,
        function-zarccos: option<keyword-style>,
        function-zarcsin: option<keyword-style>,
        function-zarctan: option<keyword-style>,
        function-zbitand: option<keyword-style>,
        function-zbitcount: option<keyword-style>,
        function-zbitfind: option<keyword-style>,
        function-zbitget: option<keyword-style>,
        function-zbitlen: option<keyword-style>,
        function-zbitnot: option<keyword-style>,
        function-zbitor: option<keyword-style>,
        function-zbitset: option<keyword-style>,
        function-zbitstr: option<keyword-style>,
        function-zbitxor: option<keyword-style>,
        function-zboolean: option<keyword-style>,
        function-zconvert: option<keyword-style>,
        function-zcos: option<keyword-style>,
        function-zcot: option<keyword-style>,
        function-zcrc: option<keyword-style>,
        function-zcsc: option<keyword-style>,
        function-zcyc: option<keyword-style>,
        function-zdascii: option<keyword-style>,
        function-zdate: option<keyword-style>,
        function-zdateh: option<keyword-style>,
        function-zdatetime: option<keyword-style>,
        function-zdatetimeh: option<keyword-style>,
        function-zdchar: option<keyword-style>,
        function-zexp: option<keyword-style>,
        function-zf: option<keyword-style>,
        function-zhex: option<keyword-style>,
        function-zincrement: option<keyword-style>,
        function-ziswide: option<keyword-style>,
        function-zlascii: option<keyword-style>,
        function-zlchar: option<keyword-style>,
        function-zln: option<keyword-style>,
        function-zlog: option<keyword-style>,
        function-zname: option<keyword-style>,
        function-zobjclass: option<keyword-style>,
        function-zobjclassmethod: option<keyword-style>,
        function-zobjmethod: option<keyword-style>,
        function-zobjproperty: option<keyword-style>,
        function-zobjref: option<keyword-style>,
        function-zorder: option<keyword-style>,
        function-zposition: option<keyword-style>,
        function-zpower: option<keyword-style>,
        function-zprevious: option<keyword-style>,
        function-zqascii: option<keyword-style>,
        function-zqchar: option<keyword-style>,
        function-zsearch: option<keyword-style>,
        function-zsec: option<keyword-style>,
        function-zseek: option<keyword-style>,
        function-zsin: option<keyword-style>,
        function-zsqr: option<keyword-style>,
        function-zstrip: option<keyword-style>,
        function-ztan: option<keyword-style>,
        function-ztime: option<keyword-style>,
        function-ztimeh: option<keyword-style>,
        function-zutil: option<keyword-style>,
        function-zversion: option<keyword-style>,
        function-zwascii: option<keyword-style>,
        function-zwbpack: option<keyword-style>,
        function-zwbunpack: option<keyword-style>,
        function-zwchar: option<keyword-style>,
        function-zwidth: option<keyword-style>,
        function-zwpack: option<keyword-style>,
        function-zwunpack: option<keyword-style>,
        function-zzenkaku: option<keyword-style>,
    }

    enum diagnostic-severity {
        error,
        warning,
        information,
        hint,
    }

    record diagnostic {
        message: string,
        range: range,
        related-information: list<diagnostic-related-information>,
        severity: diagnostic-severity,
        // A fixed id for the kind of finding, e.g. `A1234`.
        code: string,
        // The kind's documentation: a docs.rs url for the running version.
        code-description: string,
    }

    record inlay-hint {
        position: position,
        label: string,
        padding-left: bool,
        padding-right: bool,
    }

    enum symbol-kind {
        class,
        // A routine, which has no enclosing class.
        module,
        method,
        property,
        %interface,
        function,
        constant,
        array,
        object,
        key,
        %struct,
        event,
    }

    record symbol-info {
        name: string,
        kind: symbol-kind,
        deprecated: bool,
        range: range,
        selection-range: range,
    }

    // A `textDocument/documentSymbol` outline: the document's class or routine, and its members or
    // labels. Flat, since a WIT record can't contain itself.
    record document-symbol {
        root: symbol-info,
        members: list<symbol-info>,
    }

    record workspace-symbol {
        name: string,
        kind: symbol-kind,
        deprecated: bool,
        location: location,
    }
}

interface imported {
    use common.{class-info, routine-info, source};

    resource iris-connection {
        // `name`'s own (not inherited) members, superclasses and class-level metadata.
        get-cls: func(name: string) -> option<class-info>;
        // The full text of `name.inc`, code included.
        get-inc: func(name: string) -> option<source>;
        // Apart from `get-inc`, since a `.inc` and a `.mac` can share a name.
        get-rtn: func(name: string) -> option<routine-info>;
    }

    // The two Atelier REST API requests, for ascot to make `iris-connection`'s lookups with.
    resource atelier {
        // The rows of `/action/query`, each a JSON object keyed by column name.
        query: func(sql: string, params: list<string>) -> option<list<string>>;
        // The lines of `/doc/{name}`.
        get-doc: func(name: string) -> option<list<string>>;
    }

    variant env {
        connection(iris-connection),
        atelier(atelier),
    }
}

interface exported {
    use common.{
        member-info, class-info, position,
        diagnostic, inlay-hint, range, location,
        document-symbol, workspace-symbol, style,
    };
    use imported.{env};

    resource workspace {
        constructor(env: option<env>, style: option<style>);
        // Open or edit (kind from `uri`'s extension); returns the uris now stale.
        open: func(uri: string, text: string) -> list<string>;
        // Returns the uris now stale.
        close: func(uri: string) -> list<string>;
        diagnostics: func(uri: string) -> list<diagnostic>;
        inlay-hint: func(uri: string, range: range) -> list<inlay-hint>;
        definition: func(uri: string, position: position) -> option<location>;
        references: func(uri: string, position: position, include-declaration: bool) -> list<location>;
        hover: func(uri: string, position: position) -> option<string>;
        query-cls: func(query: string) -> list<tuple<string, class-info>>;
        query-mem: func(cls: string, query: string) -> list<tuple<string, member-info>>;
        document-symbol: func(uri: string) -> option<document-symbol>;
        workspace-symbol: func(query: string) -> list<workspace-symbol>;
    }
}

world ascot {
    import imported;
    export exported;
}
