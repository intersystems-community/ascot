{
  "name": "@intersystems-community/ascot",
  "version": "0.4.3",
  "description": "ascot, a type checker and code intelligence engine for InterSystems ObjectScript, for Node and other JS consumers.",
  "license": "MIT OR Apache-2.0",
  "keywords": [
    "intersystems",
    "iris",
    "objectscript",
    "type-checker",
    "static-analysis",
    "language-server",
    "wasm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/intersystems-community/ascot.git",
    "directory": "bindings/js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "generated",
    "lib/*.core*.wasm"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "test": "node --test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@bytecodealliance/jco": "^1.37.0",
    "@types/node": "^26.6.5",
    "prettier": "3.9.10",
    "typescript": "^7.0.2"
  }
}
