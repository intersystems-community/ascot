{
    "name": "ascot-lsp",
    "version": "0.4.2",
    "description": "ascot as an LSP server for InterSystems ObjectScript",
    "lspServers": {
        "objectscript": {
            "command": "ascot",
            "args": [
                "lsp"
            ],
            "extensionToLanguage": {
                ".cls": "objectscript",
                ".mac": "objectscript",
                ".int": "objectscript",
                ".inc": "objectscript"
            }
        }
    }
}
